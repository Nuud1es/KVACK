.venv/
__pycache__/
*.pyc
.env
.mypy_cache/
.ruff_cache/
.pytest_cache/
node_modules/
dist/
# Real company documents never go in git
data/real/
evals/spike_docs/

# Generated by infra scripts (secrets)
infra/.env
infra/.langfuse/
infra/monitoring/prometheus/prometheus.yml
infra/monitoring/prometheus/metrics_token

# Synthetic sample documents are tracked (the repo-wide *.pdf rule protects real ones)
!data/samples/*.pdf

# Dev mailer output
outbox/

# Results of CI runs of the live evals (the recorded baselines are committed)
evals/results/ci.json
evals/results/*_ci.json

# Real/public test documents supplied for evaluation: never committed
trainingData/

# API log written by start-api.bat
logs/
logs-api.out

infra/monitoring/alertmanager/alertmanager.yml
infra/monitoring/alertmanager/.ntfy_url

# Personal config and notes: real hosts, names, keys
CLAUDE.local.md
