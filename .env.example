# Reached over Tailscale: this machine must be logged in to the tailnet. No API key needed there,
# but the SDK needs a non-empty placeholder.
QACOPILOT_LLM_BASE_URL=https://<llm-host>.<tailnet>.ts.net/v1
# Use "not-needed" only for a server on a private network. If the LLM is exposed with Tailscale
# Funnel it MUST have a real key: start llama-server with --api-key <secret> and put it here.
QACOPILOT_LLM_API_KEY=not-needed
QACOPILOT_LLM_MODEL=nemotron
QACOPILOT_API_KEY=
# true = people register with a name and a 4-digit PIN (needs the database; run migrate first).
# Only for a private network: 10,000 possible PINs, protected by a lock-out after 5 wrong tries.
QACOPILOT_ACCOUNTS=false
# Who may open the Accounts page (comma separated names). Their accounts are made in a terminal,
# not on the sign-up form:  python -m qa_api.users create "Joe Rudling"
QACOPILOT_ADMINS=
QACOPILOT_DATABASE_URL=postgresql+psycopg://qacopilot:<password>@<laptop-ip>:5432/qacopilot
QACOPILOT_QDRANT_URL=http://<laptop-ip>:6333
QACOPILOT_LANGFUSE_HOST=http://<laptop-ip>:3000
QACOPILOT_LANGFUSE_PUBLIC_KEY=
QACOPILOT_LANGFUSE_SECRET_KEY=

# Optional: database for tests (a throwaway schema is created and dropped). Defaults to DATABASE_URL.
# QACOPILOT_TEST_DATABASE_URL=

# --- agent -------------------------------------------------------------------------------------
# One key per person, so approvals and the audit log name who acted: "alice:key1,bob:key2".
QACOPILOT_API_KEYS=
# Who calibration reminders go to (comma-separated). With none set, reminder runs are 'blocked'.
QACOPILOT_REMINDER_RECIPIENTS=
# "file" writes .eml files to MAIL_OUTBOX_DIR (development); "outlook" needs Windows + Outlook.
QACOPILOT_MAIL_BACKEND=file
QACOPILOT_MAIL_OUTBOX_DIR=outbox
# outlook only: "draft" saves to Drafts for a person to send; "send" sends immediately.
QACOPILOT_OUTLOOK_MODE=draft
